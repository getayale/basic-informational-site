<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body{
        font-family: Arial, Helvetica, sans-serif;
          background-color: #f4f7fb;
    }
  </style>
</head>
<body>
  <h1><%= title %></h1>

  <% messages.forEach((message) => { %>
    <article>
      <h2><%= message.user %></h2>
      <p><%= message.text %></p>
      <small><%= message.added.toLocaleString() %></small>
      <a href="/message/<%= message.id %>">Open</a>
    </article>
    <hr>
  <% }); %>

  <a href="/new">Create a New Message</a>
</body>
</html>